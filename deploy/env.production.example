# Copy to /etc/zelscan/zelscan.env, replace placeholders, then chmod 600.
# Never paste real secret values into this example file.
ZELSCAN_ENV=production
DEBUG=false
HOST=127.0.0.1
PORT=5050
FRONT_HOST=127.0.0.1
FRONT_PORT=8080
BACKEND_URL=http://127.0.0.1:5050
DB_PATH=/opt/zelscan/zelscan.db
CACHE_DIR=/opt/zelscan/cache
RAW_MESSAGES_DIR=/opt/zelscan/data/private/raw_messages
LOG_DIR=/opt/zelscan/logs
SECRETS_DIR=/opt/zelscan/secrets
SESSION_COOKIE_SECURE=true
ALLOWED_ORIGINS=https://DOMAIN_PLACEHOLDER
LOLZ_OAUTH_CLIENT_ID=REPLACE_WITH_EXISTING_VALUE_OR_LEAVE_UNSET_IF_FILE_IS_USED
LOLZ_OAUTH_REDIRECT_URI=https://DOMAIN_PLACEHOLDER/oauth/callback
LOLZ_OAUTH_REDIRECT_URIS=https://DOMAIN_PLACEHOLDER/oauth/callback
LOLZ_TOPUP_SUCCESS_URL=https://DOMAIN_PLACEHOLDER/billing
# Existing secret files remain supported in /opt/zelscan; do not move or rotate them.
# LOLZ_MARKET_TOKEN=
# LOLZ_MERCHANT_ID=
# TURNSTILE_SITEKEY=
# TURNSTILE_SECRET=
